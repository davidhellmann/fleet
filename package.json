{
  "name": "fleet",
  "private": true,
  "type": "module",
  "description": "A control desk for a set of repos: machine setup, shared skills and a local dashboard",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dashboard": "node dashboard/collect/index.ts; astro dev --root dashboard",
    "collect": "node dashboard/collect/index.ts",
    "typecheck": "astro check --root dashboard",
    "test": "vitest run",
    "repo-list": "node scripts/write-repo-list.ts",
    "repo-list:check": "node scripts/write-repo-list.ts --check",
    "skills:update": "npx -y \"$(node -p \"require('./skills.json').cli\")\" update --global --yes"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "1.5.0",
    "astro": "~7.4.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
